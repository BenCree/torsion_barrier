        {MACE} {input.script} \\
          --scan {input.scan} \\
          --bond {input.bond} \\
          --out {output.pairs} > {log} 2>&1
        """


rule finetune_graph:
    """The same head on espaloma's graph embedding instead of DPA3's descriptor.

    QUESTION. Does a purpose-trained graph network carry torsion chemistry that a
    pretrained atomistic descriptor does not, and what does the swap cost? The
    head is unchanged, so the arms differ in the representation and nothing else.
    Answered either way by held-out profile RMSE against the DPA3 arm on the same
    split, and against espaloma 0.4.0's own published 1.18 kcal/mol on
    TorsionNet500 (Clark et al., ChemRxiv 2026, Table 1).

    WHY IT MIGHT WIN. espaloma 0.4.0 reaches 1.18 with a torsion readout whose
    phase is FIXED to {0, pi}: "we do not fit phases and periodicities of
    torsions as they are discrete". This head fits the phase continuously through
    s_n, so the two differ in exactly one thing. And espaloma's embedding is a
    function of the molecular graph alone, so k_n stops depending on which
    conformer was in hand, which cost the DPA3 arm 0.326 kcal/mol on 2026-09-13
    (1.324 to 1.650, intervals not overlapping).

    ON WHAT. The same cached torsiondrives, the same split, the same seed as the
    DPA3 arms. One independent unit is a molecule.

    CONTROLS. The DPA3 arm on identical rows; MMFF94 and the flat profile carried
    through both tables unchanged.

    UNITS. kcal/mol relative to each scan's own minimum. Training seconds are
    measured, not estimated: espaloma's stage 1 is 1.2 M parameters against
    DPA-3.1-3M's 3 M, and 2.44 ms per molecule on CPU against 59.8 ms.

    COST. About 1 s per epoch on 604 molecules, so minutes rather than the
    DPA3 arm's 12.4 s per epoch.
    """
    input:
        torsiondrives=lambda w: (
            f"data/residual_gen3_{config['limit']}.npz" if w.target == "residual"
            else f"data/torsiondrives_gen3_{config['limit']}.npz"),
        script="finetune_torsion.py",
        encoder="espaloma_encoder.py",
        nagl="nagl_encoder.py",
        helper="fit_torsion_head.py",
        model="/home/ben/code/openff-nagl/openff/nagl/torsion/model.py",
        alpha="/home/ben/code/openff-nagl/openff/nagl/torsion/alpha.py",
    output:
        profiles="data/profiles_{encoder}_{target}.csv",
        per_molecule="data/per_molecule_{encoder}_{target}.csv",
        quarantine="data/{encoder}_{target}_quarantine.csv",
        history="results/loss_{encoder}_{target}.csv",
    params:
        version=lambda w: config.get("graph_encoder_version", {}).get(
            w.encoder, "0.3.2"),
        epochs=config.get("finetune_epochs", 400),
        seed=config.get("seed", 20260911),
        sampler=config.get("sampler", "scaffold"),
        arms=config.get("espaloma_arms", "frozen,finetuned_reference"),
    wildcard_constraints:
        encoder=r"(espaloma|nagl|dpa3)",
        target=r"(total|residual)",
    resources:
        gpu=1,
    log:
        "logs/finetune_{encoder}_{target}.log",
    shell:
        """
        {ESPALOMA} {input.script} \
          --torsiondrives {input.torsiondrives} \
          --encoder {wildcards.encoder} \
          --espaloma-version {params.version} \
          --arms {params.arms} \
          --epochs {params.epochs} \
          --seed {params.seed} \
          --sampler {params.sampler} \
          --rotors driven \
          --profiles {output.profiles} \
          --per-molecule {output.per_molecule} \
          --quarantine {output.quarantine} \
          --history {output.history} > {log} 2>&1
        """


rule cost_stack:
    """Seconds per molecule for every bond at N angles, by stack.

    The question, the split into a parameter pass and a query, why a graph
    encoder pays the pass once and an atomistic descriptor once per conformer,
    the controls and the units are all in `cost_encoders.py`'s docstring, which
    this rule does not restate. What belongs here: the three stacks live in
    three environments that cannot share a process, so this is one invocation
    each and the tables are merged afterwards rather than compared across a
    boundary nobody measured.
    """
    input:
        script="cost_encoders.py",
        torsiondrives=f"data/torsiondrives_gen3_{config['limit']}.npz",
        model="/home/ben/code/openff-nagl/openff/nagl/torsion/model.py",
    output:
        csv="data/cost_{stack}_{device}.csv",
    params:
        interpreter=lambda w: {"dpa3": DPA3, "espaloma": ESPALOMA,
                               "espaloma_native": ESPALOMA}[w.stack],
        n_molecules=config.get("cost_molecules", 50),
        checkpoint=config["checkpoint"],
        model_config=config["model_config"],
    wildcard_constraints:
        stack=r"(dpa3|espaloma|espaloma_native)",
        device=r"(cpu|cuda)",
    resources:
        gpu=lambda w: 1 if w.device == "cuda" else 0,
    log:
        "logs/cost_{stack}_{device}.log",
    shell:
        """
        CUDA_VISIBLE_DEVICES=$(test {wildcards.device} = cpu && echo "" || echo "${{CUDA_VISIBLE_DEVICES:-0}}") \\
        {params.interpreter} {input.script} \\
          --stack {wildcards.stack} \\
          --torsiondrives {input.torsiondrives} \\
          --n-molecules {params.n_molecules} \\
          --device {wildcards.device} \\
          --checkpoint {params.checkpoint} \\
          --config {params.model_config} \\
          --out {output.csv} > {log} 2>&1
        """


rule phase_census:
    """How much of a real torsion profile is odd in the dihedral, and whose chemistry.

    The question, the controls and why this is least squares rather than a model
    comparison are in `phase_census.py`'s docstring. What belongs here: the
    number it produces is a CEILING on what any phase-fitting architecture can
    gain over any fixed-phase one, ours included, so a small answer closes the
    question for every such model at once and a large one says which chemistry
    is out of reach. It runs on the merged pool and both test sets together so
    the named molecules can be found wherever they exist.

    COST. Seconds, CPU, on data already on disk. No GPU.
    """
    input:
        script="phase_census.py",
        encoder="espaloma_encoder.py",
        pool="data/pool_merged.npz",
        tn500="data/test/torsionnet500.npz",
        tt2000="data/test/torsiontest2000.npz",
    output:
        census="data/phase_census.csv",
        named="data/phase_named.csv",
        quarantine="data/phase_census_quarantine.csv",
    log:
        "logs/phase_census.log",
    shell:
        """
        {ESPALOMA} {input.script} \\
          --torsiondrives {input.pool} {input.tn500} {input.tt2000} \\
          --out {output.census} \\
          --named {output.named} \\
          --quarantine {output.quarantine} > {log} 2>&1
        """


rule espaloma_phase_check:
    """Does espaloma's TRAINED model produce the odd part, or only permit it?

    The question, the metric and what this is not are in
    `espaloma_phase_check.py`'s docstring. What belongs here: the phase census
    showed a free phase buys 0.021 kcal/mol where a fixed-phase form provably
    cannot reach it, which closes the ARCHITECTURE argument. It does not close
    the empirical one, because espaloma's form spanning the odd component is not
    the same as its trained network producing it, and nothing in its loss
    singles the odd part out. This measures the difference.

    COST. One espaloma forward per molecule, about 6 ms. No GPU needed.
    """
    input:
        script="espaloma_phase_check.py",
        census="phase_census.py",
        encoder="espaloma_encoder.py",
        pool="data/pool_merged.npz",
    output:
        csv="data/espaloma_phase_check.csv",
        quarantine="data/espaloma_phase_quarantine.csv",
    log:
        "logs/espaloma_phase_check.log",
    shell:
        """
        {ESPALOMA} {input.script} \\
          --torsiondrives {input.pool} \\
          --out {output.csv} \\
          --quarantine {output.quarantine} > {log} 2>&1
        """


rule mm_baseline:
    """Replace the target with the torsion RESIDUAL, E_QM - E_MM,no-torsion.

    The reasoning, the charge model and why it is not a choice are in
    `mm_baseline.py`'s docstring. What belongs here: the output is an npz in
    this project's own cache format with `energy::key` replaced, so every rule
    downstream reads it unchanged and an arm trained on it differs from the
    current arms in the TARGET and in nothing else.

    ON WHAT. The same cohort the published arms used.

    CONTROLS. `--keep-torsions` produces the same file with Sage's own proper
    torsions left in, so the residual is QM minus the FULL force field and what
    comes out is Sage's own error on these molecules. That is the standard: a
    head fitted to the residual has to beat leaving Sage's torsions in place.

    UNITS. kcal/mol, both sides referenced to their own minimum before
    subtracting so an arbitrary constant offset cannot enter.

    COST. One Interchange per molecule, seconds each, CPU.
    """
    input:
        script="mm_baseline.py",
        encoder="espaloma_encoder.py",
        torsiondrives=f"data/torsiondrives_gen3_{config['limit']}.npz",
    output:
        npz="data/residual_gen3_{limit}.npz",
        quarantine="data/residual_gen3_{limit}_quarantine.csv",
    params:
        forcefield=config.get("mm_baseline_forcefield", "openff-2.3.0.offxml"),
    wildcard_constraints:
        limit=r"\d+",
    log:
        "logs/mm_baseline_{limit}.log",
    shell:
        """
        {OPENFE} {input.script} \\
          --torsiondrives {input.torsiondrives} \\
          --forcefield {params.forcefield} \\
          --out {output.npz} \\
          --quarantine {output.quarantine} > {log} 2>&1
        """


rule reconstruct:
    """Put a residual-target arm back on the QM axis so it can be compared.

    The reasoning, how the MM baseline comes back by difference without having
    been stored, and why three metrics rather than one are in
    `reconstruct_residual.py`'s docstring. What belongs here: without this an
    arm trained on E_QM - E_MM,no-torsion and an arm trained on E_QM report
    errors against two different quantities, and putting them in one table would
    be the kind of comparison that looks like a result and is not.

    CONTROLS. The MM baseline alone is scored on the same rows, so an arm has to
    beat Sage's own bonded and nonbonded terms with no torsion at all.

    COST. A join and some arithmetic. Seconds, CPU.
    """
    input:
        script="reconstruct_residual.py",
        qm=f"data/torsiondrives_gen3_{config['limit']}.npz",
        residual=f"data/residual_gen3_{config['limit']}.npz",
        residual_profiles="data/profiles_{encoder}_residual.csv",
        total_profiles="data/profiles_{encoder}_total.csv",
    output:
        csv="data/reconstructed_{encoder}.csv",
    wildcard_constraints:
        encoder=r"(espaloma|nagl|dpa3)",
    log:
        "logs/reconstruct_{encoder}.log",
    shell:
        """
        {MACE} {input.script} \\
          --qm {input.qm} \\
          --residual {input.residual} \\
          --residual-profiles {input.residual_profiles} \\
          --total-profiles {input.total_profiles} \\
          --out {output.csv} > {log} 2>&1
        """


rule phased:
    """Does a fitted phase help, with every other choice held identical?

    The question, why it is per torsion rather than per bond, and why comparing
    against espaloma as published would confound the phase with a different
    training set are in `phased_torsion.py`'s docstring. What belongs here: the
    unphased arm reproduces espaloma's functional form exactly, in this code,
    on this data, with this optimiser, so the paired difference isolates one
    thing. That is the comparison the phase census says is worth making and the
    one nothing in the literature has run.

    COST. espaloma's stage 1 is 1.4 ms per molecule on a card and the head is
    tiny, so an epoch on 600 molecules is about a second.
    """
    input:
        script="phased_torsion.py",
        trainer="finetune_torsion.py",
        encoder="espaloma_encoder.py",
        torsiondrives=f"data/torsiondrives_gen3_{config['limit']}.npz",
    output:
        csv="data/phased_{encoder}_js{js}_{mode}.csv",
        quarantine="data/phased_{encoder}_js{js}_{mode}_quarantine.csv",
        checkpoint="data/phased_{encoder}_js{js}_{mode}.pt",
    params:
        version=lambda w: config.get("graph_encoder_version", {}).get(
            w.encoder, "0.3.2"),
        epochs=config.get("finetune_epochs", 400),
        seed=config.get("seed", 20260911),
        js=lambda w: float(w.js) / 100.0,
        finetune=lambda w: ("--finetune-encoder"
                            if w.mode == "finetuned" else ""),
    wildcard_constraints:
        encoder=r"(espaloma|nagl)",
        js=r"\d+",
        mode=r"(frozen|finetuned)",
    resources:
        gpu=1,
    log:
        "logs/phased_{encoder}_js{js}_{mode}.log",
    shell:
        """
        {ESPALOMA} {input.script} \\
          --torsiondrives {input.torsiondrives} \\
          --encoder {wildcards.encoder} \\
          --espaloma-version {params.version} \\
          --epochs {params.epochs} \\
          --seed {params.seed} \\
          --js-weight {params.js} \
          {params.finetune} \\
          --checkpoint {output.checkpoint} \
          --out {output.csv} \\
          --quarantine {output.quarantine} > {log} 2>&1
        """


